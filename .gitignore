*.class

# 로그 파일
*.log

# Java 임시 파일
*.ctxt
.mtj.tmp/

# JVM 오류 로그
hs_err_pid*
replay_pid*

# ========================================
# Java 빌드 패키지
# ========================================

*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper 실행 파일은 Git에 포함
!gradle/wrapper/gradle-wrapper.jar

# ========================================
# Gradle
# ========================================

# Gradle 캐시
.gradle/

# 빌드 결과물 및 테스트 보고서
build/

# ========================================
# IntelliJ IDEA
# ========================================

# IDE 개인 설정
.idea/

# IntelliJ 모듈 파일
*.iml

# IDE 컴파일 출력
out/

# ========================================
# 환경변수 및 민감정보
# ========================================

# 환경변수 파일
.env
.env.*

# 예시 환경변수 파일은 포함
!.env.example

# 개인 및 비밀 설정 파일
application-local.properties
application-secret.properties
application-local.yml
application-secret.yml
application-local.yaml
application-secret.yaml

